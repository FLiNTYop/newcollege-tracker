<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — College Tracker</title>
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <meta name="theme-color" content="#14161a">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="topbar">
    <div class="topbar-mark">CT</div>
    <div class="topbar-user"><%= user.email %></div>
    <div class="topbar-actions">
      <button id="scanBtn" class="btn-ghost">Scan now</button>
      <button id="settingsBtn" class="btn-ghost">Notifications</button>
      <a href="/logout" class="btn-ghost">Log out</a>
    </div>
  </header>

  <main class="board">
    <section class="board-head">
      <h1>Your tasks</h1>
      <p class="board-sub" id="taskCount"><%= tasks.length %> open item<%= tasks.length === 1 ? '' : 's' %></p>
    </section>

    <% if (tasks.length === 0) { %>
      <div class="empty-state">
        <p>Nothing tracked yet.</p>
        <p class="empty-sub">Hit <strong>Scan now</strong> to check Gmail and Classroom for the first time, or just wait — it scans automatically every 15 minutes.</p>
      </div>
    <% } else { %>
      <div class="task-list">
        <% tasks.forEach(task => { %>
          <%
            let urgency = 'none';
            if (task.due_date) {
              const today = new Date(); today.setHours(0,0,0,0);
              const due = new Date(task.due_date); due.setHours(0,0,0,0);
              const diffDays = Math.round((due - today) / (1000*60*60*24));
              if (diffDays < 0) urgency = 'overdue';
              else if (diffDays === 0) urgency = 'today';
              else if (diffDays <= 3) urgency = 'soon';
              else urgency = 'later';
            }
          %>
          <div class="task-card urgency-<%= urgency %>" data-id="<%= task.id %>">
            <div class="task-source"><%= task.source === 'classroom' ? '📘 Classroom' : '📧 Gmail' %></div>
            <h3 class="task-title"><%= task.title %></h3>
            <p class="task-meta"><%= task.course_or_sender %></p>
            <% if (task.detail) { %><p class="task-detail"><%= task.detail %></p><% } %>
            <div class="task-foot">
              <span class="task-due">
                <% if (task.due_date) { %>
                  Due <%= task.due_date %>
                  <% if (urgency === 'overdue') { %><span class="tag tag-overdue">overdue</span><% } %>
                  <% if (urgency === 'today') { %><span class="tag tag-today">today</span><% } %>
                <% } else { %>
                  No due date detected
                <% } %>
              </span>
              <div class="task-actions">
                <% if (task.link) { %><a href="<%= task.link %>" target="_blank" class="link-open">Open</a><% } %>
                <button class="btn-done" data-id="<%= task.id %>">Done</button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>

  <div id="settingsModal" class="modal hidden">
    <div class="modal-card">
      <h2>Push notifications</h2>
      <p class="modal-sub">Install the <a href="https://ntfy.sh" target="_blank">ntfy app</a> on your phone and laptop, then subscribe to this topic name (keep it private — anyone with it can send you alerts):</p>
      <div class="topic-row">
        <input id="topicInput" type="text" value="<%= user.ntfy_topic %>" />
        <button id="saveTopic" class="btn-primary">Save</button>
      </div>
      <p class="modal-status" id="topicStatus"></p>
      <button id="closeModal" class="btn-ghost" style="margin-top: 16px;">Close</button>
    </div>
  </div>

  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }
  </script>
  <script src="/dashboard.js"></script>
</body>
</html>
