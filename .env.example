# Copy this file to .env and fill in real values.
# Never commit the real .env file to GitHub.

# From Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must exactly match the redirect URI registered in Google Cloud Console.
# For local testing: http://localhost:3000/auth/callback
# After deploying to Render: https://your-app-name.onrender.com/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Any random long string — used to sign login session cookies
SESSION_SECRET=change-this-to-something-random-and-long

# Comma-separated list of email domains that should be treated as
# extra-trustworthy when scoring importance, e.g. your college's domain.
# Example: TRUSTED_EMAIL_DOMAINS=mycollege.edu,classroom.google.com
TRUSTED_EMAIL_DOMAINS=

PORT=3000
